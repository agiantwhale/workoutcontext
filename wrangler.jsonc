{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workoutcontext",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  // Generates src/generated/commit.ts (gitignored) before every bundle so the
  // worker can render the deployed commit SHA in page footers. Runs regardless
  // of how wrangler is invoked (direct `wrangler deploy`, `npm run deploy`,
  // `wrangler dev`, Cloudflare Workers Builds). See scripts/write-commit.mjs.
  "build": {
    "command": "node scripts/write-commit.mjs"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "WorkoutContextMCP" }
    ]
  },
  "kv_namespaces": [
    // Namespace title on Cloudflare: "workoutcontext-fit-oauth".
    // Created with: npx wrangler kv namespace create workoutcontext-fit-oauth
    { "binding": "OAUTH_KV", "id": "244cd2fa17644a4b9af4f6484b0b4bcf" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkoutContextMCP"] }
  ],
  "observability": {
    "enabled": true
  },
  // Staging environment: deployed to staging.workoutcontext.fit with its own
  // KV namespace and Durable Object so it can't see or mutate prod data.
  //
  // Create the staging KV namespace once:
  //   npx wrangler kv namespace create workoutcontext-staging-oauth
  // then paste the returned id into the placeholder below.
  //
  // Deploy with:  npm run deploy:staging
  // Push staging secrets with:
  //   npx wrangler secret put PUBLIC_URL --env staging
  //   npx wrangler secret put INVITE_CODE --env staging   # optional
  //
  // Add staging.workoutcontext.fit to Cloudflare DNS (proxied A/CNAME).
  "env": {
    "staging": {
      "name": "workoutcontext-staging",
      "routes": [
        { "pattern": "staging.workoutcontext.fit/*", "zone_name": "workoutcontext.fit" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "MCP_OBJECT", "class_name": "WorkoutContextMCP" }
        ]
      },
      "kv_namespaces": [
        // Namespace title on Cloudflare: "workoutcontext-staging-oauth".
        // Created with: npx wrangler kv namespace create workoutcontext-staging-oauth
        { "binding": "OAUTH_KV", "id": "3b5f7c59625d49aab8f8ae23b59d72a1" }
      ],
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["WorkoutContextMCP"] }
      ],
      "observability": {
        "enabled": true
      }
    },
    // Preview environment: every push to a non-production branch (anything
    // not `main` or `staging`) deploys here. Cloudflare's Workers Builds
    // "Preview URLs" feature mints a unique versioned URL per push of the
    // form `<version-hash>-workoutcontext-preview.<account>.workers.dev`,
    // so each PR has its own browseable URL. All preview deploys share the
    // same worker name / KV / DO — so multiple in-flight PRs are state-
    // adjacent, not state-isolated.
    //
    // Useful for UI / copy / internal-logic PRs. NOT useful for OAuth or
    // webhook changes: provider redirect URIs are registered against
    // staging.workoutcontext.fit, and webhook URLs are per-OAuth-app —
    // neither will fire against a preview URL. Test those on staging.
    //
    // One-time setup on Cloudflare:
    //   npx wrangler kv namespace create workoutcontext-preview-oauth
    //     # paste the returned id into the placeholder below.
    //   # Push secrets (mirror staging's set):
    //   npx wrangler secret put PUBLIC_URL --env preview
    //   npx wrangler secret put INTERVALS_CLIENT_ID --env preview
    //   ...etc for every secret staging needs.
    //   # In Cloudflare dashboard: Workers Builds → Build watcher →
    //   #   Production branch: `main`
    //   #   Preview branches:  `staging` (deploys to `staging` env),
    //   #                      `*`       (deploys to `preview` env)
    //   # Build command for preview branches:
    //   #   npm run deploy:preview
    "preview": {
      "name": "workoutcontext-preview",
      "durable_objects": {
        "bindings": [
          { "name": "MCP_OBJECT", "class_name": "WorkoutContextMCP" }
        ]
      },
      "kv_namespaces": [
        // Namespace title on Cloudflare: "workoutcontext-preview-oauth".
        // Created with: npx wrangler kv namespace create workoutcontext-preview-oauth
        // Replace the placeholder id below with the value `wrangler` returns.
        { "binding": "OAUTH_KV", "id": "REPLACE_WITH_PREVIEW_KV_NAMESPACE_ID" }
      ],
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["WorkoutContextMCP"] }
      ],
      "observability": {
        "enabled": true
      }
    }
  }
}
