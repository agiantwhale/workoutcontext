{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workoutcontext-fit",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "WorkoutContextMCP" }
    ]
  },
  "kv_namespaces": [
    // Create with: npx wrangler kv namespace create OAUTH_KV
    // then replace the id below with the returned value.
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_ID" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkoutContextMCP"] }
  ],
  "observability": {
    "enabled": true
  }
}
