{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workoutcontext",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "WorkoutContextMCP" }
    ]
  },
  "kv_namespaces": [
    // Namespace title on Cloudflare: "workoutcontext-fit-oauth".
    // Created with: npx wrangler kv namespace create workoutcontext-fit-oauth
    { "binding": "OAUTH_KV", "id": "244cd2fa17644a4b9af4f6484b0b4bcf" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkoutContextMCP"] }
  ],
  "observability": {
    "enabled": true
  }
}
